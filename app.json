{
  "expo": {
    "name": "camscanner-expo",
    "slug": "camscanner-expo",
    "version": "2.6.2",
    "scheme": "camscanner",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.antigravity.camscanner",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Cho phép ứng dụng truy cập thư viện ảnh để nhập và lưu tài liệu scan.",
        "NSPhotoLibraryAddUsageDescription": "Cho phép ứng dụng lưu ảnh và file PDF đã scan vào thư viện ảnh."
      }
    },
    "android": {
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.antigravity.camscanner"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CamScanner to access your camera to scan documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CamScanner to access your photos."
        }
      ],
      [
        "expo-document-picker",
        {}
      ],
      "expo-web-browser",
      "react-native-document-scanner-plugin",
      "expo-font"
    ]
  }
}
